# Copy this file to .env and fill values for your environment
# Database
DB_HOST=127.0.0.1
DB_NAME=teaching_website
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Application
BASE_URL=/
UPLOADS_DIR=uploads
MAX_UPLOAD_SIZE=10485760

# Mail (SMTP)
SMTP_HOST=smtp.example.com
SMTP_USER=you@example.com
SMTP_PASS=secret
SMTP_PORT=587
MAIL_FROM=no-reply@example.com

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# UPI - optional (for display / QR)
UPI_VPA=your@upi
UPI_QR_IMAGE=uploads/upi_qr.png
